# Copy to .env for local runs. Never commit real values; nothing here identifies a project.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=
# BigQuery (deployed): BQ_PROJECT wins over GOOGLE_CLOUD_PROJECT (Agent Runtime may expose a project number)
DATA_BACKEND=local
BQ_PROJECT=
BQ_DATASET=energy_alphaevolve_lab
BQ_LOCATION=asia-northeast1
# Agent backend for the server: local (in-process ADK Runner) or agent_engine (Agent Runtime resource)
AGENT_BACKEND=local
AGENT_ENGINE_ID=
AGENT_ENGINE_LOCATION=asia-northeast1
# Model tiers (energy_lab/model_policy.py); Gemini 3.x resolves at location global only
MODEL_REASONING=gemini-3.1-pro-preview
MODEL_BALANCED=gemini-3.6-flash
MODEL_FAST=gemini-3.5-flash-lite
MUTATOR_WEIGHT_BALANCED=0.7
MUTATOR_THINKING_LEVEL=MEDIUM
# Token price assumptions for cost estimates in evidence files (USD per 1M tokens)
PRICE_BALANCED_IN=0.50
PRICE_BALANCED_OUT=3.00
PRICE_REASONING_IN=2.00
PRICE_REASONING_OUT=12.00
# Budget ledger (production defaults from the alphaevolve skill)
AE_MAX_PROGRAMS=40
AE_MAX_WALL_S=1800
AE_MAX_PROGRAMS_PER_DAY=120
AE_MAX_RUNS_PER_DAY=4
AE_PLATEAU_PATIENCE=15
AE_CONCURRENCY=2
# Real AlphaEvolve backend (--backend alphaevolve): Gemini Enterprise app with AlphaEvolve provisioned
GE_APP_ID=
GE_COLLECTION=default_collection
GE_ASSISTANT=default_assistant
# Optional path overrides
LAB_RUNS_DIR=
LAB_INSTANCE_DIR=
LAB_DATA_DIR=
