# Copy to .env and fill in. Never commit real values. The dataset is not the project.
# Model access (Gemini 3.x resolves at the global location)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Model tiers (retail_desk/model_policy.py defaults)
MODEL_REASONING=gemini-3.1-pro-preview
MODEL_BALANCED=gemini-3.6-flash
MODEL_FAST=gemini-3.5-flash-lite
# Model client location (Gemini 3.x only at global); independent of the Agent Runtime region
MODEL_LOCATION=global
# Data: local (DuckDB over data/out/*.csv) or bigquery
DATA_BACKEND=local
BQ_DATASET=tepco_retail_desk_demo
# BQ_PROJECT wins over GOOGLE_CLOUD_PROJECT for BigQuery (Agent Runtime may expose the project as a number)
BQ_PROJECT=
BQ_LOCATION=asia-northeast1
LOCAL_DATA_DIR=
# Agents: local (ADK Runner in-process) or agent_engine (deployed Agent Runtime resource)
AGENT_BACKEND=local
AGENT_ENGINE_ID=
AGENT_ENGINE_LOCATION=asia-northeast1
# Scenario clock and controls
DESK_NOW=2026-08-19T15:40
INJECTION_SCANNER=on
PORT=8080
