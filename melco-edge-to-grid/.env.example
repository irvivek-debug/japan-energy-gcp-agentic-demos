# Copy to .env (never commit .env). No value here identifies a project or account.
# --- Gemini on Vertex AI (Gemini 3.x resolves only at the global location) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=
# --- Model tiers (factory_copilot/model_policy.py) ---
MODEL_REASONING=gemini-3.1-pro-preview
MODEL_BALANCED=gemini-3.6-flash
MODEL_FAST=gemini-3.5-flash-lite
# --- Data layer: local (DuckDB over data/out/*.csv) or bigquery ---
DATA_BACKEND=local
BQ_DATASET=melco_edge_to_grid_demo
# BQ_PROJECT wins over GOOGLE_CLOUD_PROJECT (Agent Runtime may expose a project number)
BQ_PROJECT=
BQ_LOCATION=asia-northeast1
DATA_DIR=
# --- Agent backend for server/app.py: local (in-process ADK Runner) or agent_engine (deployed Agent Runtime) ---
AGENT_BACKEND=local
AGENT_ENGINE_ID=
AGENT_ENGINE_LOCATION=asia-northeast1
# --- Server ---
PORT=8082
